pipeline/.venv/
__pycache__/
characters/*/work*/
.pytest_cache/
# referencias de terceros (sprite rips): solo para analizar, nunca al repo
research_notes/*/refs/
.DS_Store
# config personal de Claude Code (permisos de esta máquina)
.claude/settings.local.json
.claude/worktrees/
# clips derivados, que el pipeline ya no usa: los limpios de los scripts sueltos del ranger (ahora la
# limpieza la hace spritepipe desde clips/raw/) y el shoot sin fogonazo del comando (ahora remove_flash).
# Los originales de los modelos sí van.
characters/ranger/clips/*.mp4
!characters/ranger/clips/run.mp4
characters/comando/clips/shoot_noflash.mp4

# juegos de prueba armados (se regeneran con prototypes/build.py)
prototypes/*/dist/
prototypes/arena/editor/dist/

# clips que bajó spritepipe bakeoff: los elegidos se copian a clips/raw/ (queda el bakeoff.md/.json)
characters/*/clips/gen*/*.mp4

# alternativas de las comparaciones de imagen (gen-images): quedan en disco y en compare.html; al repo van
# la config, compare.html/.md, gen.json, los .json de procedencia y la elegida (post/ ya commiteado, o
# copiada a poses/). Una elegida nueva en post/ se agrega con `git add -f`.
backgrounds/*/raw/**/*.png
backgrounds/*/post/**
characters/*/poses_gen/raw/**/*.png
characters/*/poses_gen/post/**

# low-poly: las tomas de los bake-offs y de las pruebas quedan en disco; al repo van las elegidas (git add -f), los
# bakeoff.md/.json, las poses elegidas (poses/) y la config. compare/, cuadros/ y las tiras de torso se rearman con
# comparar.py, cuadros.py y medir_torso.py.
characters/lowpoly/clips/*/*.mp4
characters/lowpoly/compare/
characters/lowpoly/cuadros/
characters/lowpoly/torso/**/*.png
characters/lowpoly/poses_gen/post/**


# vía 3D del low-poly (characters/lowpoly/3d): al repo van los scripts, las notas, los pedidos y respuestas de las APIs
# (con sus imágenes de entrada y las medidas), el personaje riggeado con su textura, los tres GLB animados que usa
# render.py y el GLB del arma. Los otros formatos (FBX, OBJ, STL, USDZ, los GLB repetidos) y los renders, no: se rehacen
characters/lowpoly/3d/**
!characters/lowpoly/3d/**/
!characters/lowpoly/3d/*.py
!characters/lowpoly/3d/*.md
!characters/lowpoly/3d/*.html
!characters/lowpoly/3d/*.json
!characters/lowpoly/3d/out/*/pedido.json
!characters/lowpoly/3d/out/*/respuesta.json
!characters/lowpoly/3d/out/*/thumbnail.png
!characters/lowpoly/3d/entradas/*
!characters/lowpoly/3d/torso/torso.json
!characters/lowpoly/3d/out/personaje/rigged_character_glb.glb
!characters/lowpoly/3d/out/personaje/texture_urls__0__base_color.png
!characters/lowpoly/3d/out/personaje/animation_glb.glb
!characters/lowpoly/3d/out/personaje/basic_animations__running_glb.glb
!characters/lowpoly/3d/out/personaje/basic_animations__walking_glb.glb
!characters/lowpoly/3d/out/arma/model_glb.glb

# hojas de revisión del low-poly (characters/lowpoly/revision/): se rearman con los scripts (revisar.py, arma_correr.py,
# hoja_poses.py, video_verde.py…); al repo van las notas (.md y .json). Las vistas previas del juego, lo mismo.
characters/lowpoly/revision/**/*.png
characters/lowpoly/revision/**/*.jpg
characters/lowpoly/revision/**/*.mp4
prototypes/arena/vistas_previas/
# respaldos que deja el editor al guardar
prototypes/arena/arenas/.respaldo/
