  "config": "# Comando: primer personaje real del piloto. Los comandos van desde la raíz del repo.\n# 1. Concept en ChatGPT, con transparencia: poses/comando_concept.webp.\n# 2. Pose para el modelo, 16:9 sobre magenta y sin sombra de piso:\n#      uv run --project pipeline spritepipe pad-pose poses/comando_concept.webp poses/comando_master_magenta_16x9.png\n#    Con --feet 0.92 sale poses/comando_jump_magenta_16x9.png, con aire arriba para saltos; jump_v2\n#    igual arrancó desde el master (el QA da MAD 21 contra el master y 106 contra esa pose).\n# 3. Seedance 2.0 (Veo bloqueaba el arma), image-to-video desde la pose con prompts/<anim>.txt.\n#    Los prompts que se habían preparado para Veo quedaron en prompts/veo/.\n# 4. Clips en clips/: idle.mp4, shoot.mp4 (trae fogonazo), run_v2.mp4 y jump_v2.mp4.\n#    run.mp4 y jump.mp4 son las primeras tomas, descartadas. shoot_noflash.mp4 es el derivado que\n#    se armó a mano antes de remove_flash: el pipeline ya no lo usa.\n# 5. uv run --project pipeline spritepipe run characters/comando/character.toml\n\n[character]\nname = \"comando\"\nstyle = \"hd\"\ngame_fps = 12\ntarget_height = 128\nscale_reference = \"idle\"\n\n[key]\ncolor = \"auto\"            # se mide por frame: los clips magenta traen ~#F828F4, el run vino blanco\nhole_max_frac = 0.0005    # sólo pesa en el run (fondo blanco, modo connected): con 0.01 queda blanco\n                          # atrapado entre las colas de la bandana; con esto se van y los ojos quedan\n\n[output]\nextra_scales = [0.5]\n\n[[animation]]\nname = \"idle\"\nclip = \"clips/idle.mp4\"\nkind = \"cycle\"\nloop_seconds = [1.0, 4.0]\nskip_seconds = 0.25\nmodel = \"seedance-2.0\"\nprompt = \"prompts/idle.txt\"\npose = \"../../poses/comando_master_magenta_16x9.png\"\n\n[[animation]]\nname = \"shoot\"\nclip = \"clips/shoot.mp4\"  # con fogonazo: remove_flash lo borra antes del key\nkind = \"cycle\"            # la ráfaga en loop\nloop_seconds = [0.5, 1.5]\nskip_seconds = 0.25\nloop_start = 54           # el loop que se revisó. El retroceso es parejo y los mejores candidatos\nloop_length = 16          # empatan (0,55-0,57): un nivel de color de diferencia ya los reordena\nmodel = \"seedance-2.0\"\nprompt = \"prompts/shoot.txt\"\npose = \"../../poses/comando_master_magenta_16x9.png\"\n\n# Geometría del arma medida a ojo sobre el clip de 864×496. Con `remove_flash = true` en lugar de\n# la tabla se mide sola en el frame 0: las franjas cambian 1-5 px y la boca sale igual en los 97 frames.\n[animation.remove_flash]\nband_y = [235, 275]\nsearch_x = [500, 620]\nflash_y = [195, 320]\nhalo_x0 = 538\n\n[[animation]]\nname = \"run\"\nclip = \"clips/run_v2.mp4\" # desde una pose con la zancada hecha en ChatGPT, que no está en el repo;\nkind = \"cycle\"            # vino con fondo blanco #FAFAFA porque esa imagen tenía transparencia\nloop_seconds = [1.0, 1.5]\nskip_seconds = 0.5\nmodel = \"seedance-2.0\"\nprompt = \"prompts/run.txt\"\n\n[[animation]]\nname = \"jump\"\nclip = \"clips/jump_v2.mp4\" # tres saltos seguidos; se usa el tercero, el más nítido\nkind = \"oneshot\"\nloop = false\npick = \"sharpest\"\ntrim = [58, 84]           # la subida queda dentro del sprite (~60 px): no sumarle otra en la física\nmodel = \"seedance-2.0\"\nprompt = \"prompts/jump.txt\"\npose = \"../../poses/comando_master_magenta_16x9.png\"\n",
